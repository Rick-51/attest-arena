# ---- Creditcoin 测试网（目标链）----
RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CHAIN_ID=102031

# ---- 后端钱包私钥（Creditcoin 侧；已被 PriceFeed.setBackend 授权）----
PRIVATE_KEY=

# ---- 部署后回填的合约地址（Creditcoin 侧）----
FACTION_REGISTRY=
POINTS=
PRIZE_POOL=
PRICE_FEED=

# ---- Attestcoin 价格链路 ----
# 源链 Sepolia（发价链）
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=        # worker 的 Sepolia 钱包，是 PriceSource 的 owner
# prover 服务
PROVER_URL=https://prover.cc3-testnet.creditcoin.network
# 源链 key（Creditcoin 内部编号，用 `npx tsx src/scripts/price-demo.ts chains` 复核 Sepolia）
SOURCE_CHAIN_KEY=1
# Sepolia 上的 PriceSource 地址
PRICE_SOURCE=

PORT=3000
PREDICTION=
